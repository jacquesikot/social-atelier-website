# Booking API (optional).
#
# Leave both unset to build a site that serves the static space data bundled
# in src/data/spaces.ts. That is the current default: the previous backend is
# offline, and the site degrades to bundled data on its own.
#
# WARNING: anything prefixed VITE_ is inlined into the client bundle by Vite
# and is therefore PUBLIC — readable by anyone who opens devtools. Do not put
# a credential here that must stay secret. If the API requires a real secret,
# proxy the call through a Worker function so the key stays server-side.
VITE_SPACES_API_URL=
VITE_SPACES_API_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to build without analytics — no gtag.js is loaded and no
# requests are made to Google. Create the property under the Google account
# that owns the site, then set it here.
VITE_GA4_MEASUREMENT_ID=

# Webflow CMS — powers the /blog Journal.
#
# Build-time only: scripts/fetch-blog.mjs reads published posts and writes them
# to src/data/blog.json, so the token never reaches the browser and post content
# ships as real HTML that search engines can index.
#
# Unlike VITE_ vars, these are NOT inlined into the bundle. The token is a real
# credential — keep it in .env locally and in Cloudflare's build secrets for
# git-triggered deploys. Scopes needed: cms:read.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
# Optional: defaults to the Blog Posts collection.
WEBFLOW_BLOG_COLLECTION_ID=
