{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-atelier-website",
  "compatibility_date": "2026-08-25",
  // Cloudflare creates and manages the DNS records and TLS certificates for
  // these hostnames. Both apex and www are bound so neither is a dead end.
  "routes": [
    { "pattern": "thesocialatelierng.com", "custom_domain": true },
    { "pattern": "www.thesocialatelierng.com", "custom_domain": true }
  ],
  "assets": {
    // Vite build output, with prerendered HTML per route on top of it. Static
    // assets are served straight from Cloudflare's edge — there is still no
    // Worker script: the pages are baked at build time, and the app talks to
    // the booking API directly from the browser once it hydrates.
    "directory": "./dist",
    // scripts/prerender.mjs emits dist/<route>/index.html for every route, so
    // most paths are now real assets rather than SPA fallbacks. Serve them at
    // the canonical, slash-less URL: the default would 307 /about -> /about/,
    // adding a redirect hop in front of every URL in the sitemap and pointing
    // crawlers at a URL that disagrees with the page's own canonical tag.
    "html_handling": "drop-trailing-slash",
    // Every route in src/App.tsx is prerendered to a real file, so an unmatched
    // path is a genuine 404 rather than a route the SPA still has to resolve.
    //
    // The old "single-page-application" value served dist/index.html — the
    // prerendered *homepage* — with a 200 for any unknown URL. Crawlers that do
    // not run JavaScript (the AI ones, mostly) never reached the app's "Story
    // Not Found" screen; they saw a success code and a page of real homepage
    // copy, so dead URLs like the stale Webflow slug in _redirects looked live
    // and stayed in their indexes. This serves dist/404.html with a true 404.
    "not_found_handling": "404-page"
  }
}
